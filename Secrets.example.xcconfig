// Secrets.example.xcconfig — TEMPLATE (committed).
//
// Copy to `Secrets.xcconfig` (gitignored) at the repo root and fill in real values:
//     cp Secrets.example.xcconfig Secrets.xcconfig
//
// These are injected into the app's Info.plist at build time and read by AppConfig.
// NOTE: a key embedded in a built app is extractable — fine for personal/dev use; a production
// build would proxy Claude through a backend instead.

CLAUDE_API_KEY = sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL = claude-sonnet-4-6

// Optional. Defaults to https://api.anthropic.com in AppConfig if omitted.
// CLAUDE_BASE_URL = https:/$()/api.anthropic.com
